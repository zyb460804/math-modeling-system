        "3": {"2_selection_rationale": 1.4, "1_candidate_diversity": 1.2},
        "4": {"2_assumption_support": 1.2},
        "8": {"4_language_quality": 1.2, "5_visual_consistency": 1.2}
      }
    },

    "mcm": {
      "default": {"_note": "美赛默认: 加权可解释的设计选择与 communication；不以命名制造 novelty", "3": {"2_selection_rationale": 1.3}, "8": {"3_communication_clarity": 1.3}},
      "A_continuous":        {"3": {"2_selection_rationale": 1.3, "5_literature_support": 1.2}, "4": {"2_assumption_support": 1.3}, "5": {"1_subproblem_completeness": 1.2}},
      "B_discrete":          {"3": {"2_selection_rationale": 1.2, "4_solver_feasibility": 1.3}, "5": {"2_cross_reference_chain": 1.2}},
      "C_data":              {"2": {"4_data_alignment": 1.4}, "6": {"1_multivariate_perturbation": 1.4}, "8": {"3_communication_clarity": 1.3, "5_reproducibility": 1.3}},
      "D_network":           {"2": {"1_subproblem_decomposition": 1.3}, "3": {"4_solver_feasibility": 1.3}},
      "E_interdisciplinary": {"3": {"2_selection_rationale": 1.4, "5_literature_support": 1.3}, "4": {"2_assumption_support": 1.3}, "8": {"3_communication_clarity": 1.4}},
      "F_policy":            {"3": {"2_selection_rationale": 1.3}, "7": {"4_generalization_concrete": 1.4}, "8": {"3_communication_clarity": 1.5, "2_section_completeness": 1.3}}
    },

    "diangong": {
      "default": {"_note": "电工杯默认: 加权数据完整性 + 工程实用性", "2": {"4_data_alignment": 1.4}, "5": {"5_time_budget": 1.3, "1_subproblem_completeness": 1.2}, "7": {"4_generalization_concrete": 1.3, "1_strengths_specific": 1.2}, "8": {"5_visual_engineering": 1.2}},
      "A_engineering":      {"2": {"4_data_alignment": 1.4}, "5": {"4_visual_density": 1.3, "5_time_budget": 1.3}, "6": {"1_multivariate_perturbation": 1.3, "4_robust_interval_quantitative": 1.3}},
      "B_data_engineering": {"2": {"4_data_alignment": 1.5}, "5": {"1_subproblem_completeness": 1.3, "4_visual_density": 1.2}, "8": {"5_visual_engineering": 1.3}}
    }
  }
